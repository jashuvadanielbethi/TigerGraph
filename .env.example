# --- TigerGraph ---
TG_HOST=https://your-instance.i.tgcloud.io
TG_USERNAME=tigergraph
TG_PASSWORD=changeme
TG_GRAPH_NAME=FraudInvestigation
TG_SECRET=                      # optional: pre-issued API secret, else one is created on first run

# --- LLM (either works; Anthropic preferred if both set) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# --- Agent behavior ---
AGENT_MODE=live                 # live | mock  (mock runs with no TigerGraph/LLM connection, using local fixtures)
RISK_SCORE_INVESTIGATE_THRESHOLD=0.5
RISK_SCORE_AUTO_BLOCK_THRESHOLD=0.9
MAX_EVIDENCE_ROUNDS=3

# --- HHGOA dataset raw file locations (override if not copied into data/raw/) ---
TXN_CSV=data/raw/transactions.csv
IDENTITY_CSV=data/raw/identity.csv
CLOSED_CASES_CSV=data/raw/closed_cases_history.csv
CASE_PACK_CSV=data/raw/case_pack.csv
