// ============================================================================
// FraudInvestigation graph schema -- HHGOA dataset (IEEE-CIS edition)
//
// Follows the dataset README's "Suggested graph schema" section, plus a
// case-management layer (Case/Evidence/Decision) so investigations write
// back into the graph as their own case memory. Load with:
//   gsql schema/schema.gsql
// ============================================================================

CREATE GRAPH FraudInvestigation()

USE GRAPH FraudInvestigation

// ---------------------------------------------------------------------------
// Core entity vertices
// ---------------------------------------------------------------------------

CREATE VERTEX Customer (
  PRIMARY_ID customer_id STRING       // e.g. "C01234"
) WITH primary_id_as_attribute="true"

CREATE VERTEX Card (
  PRIMARY_ID card_id STRING,          // e.g. "C01234-K1" -- ground-truth-anchored,
                                       // see data_ingest/build_index.py for how
  customer_id STRING,
  card1 STRING, card2 STRING, card3 STRING,
  card4 STRING,                       // network: visa / mastercard / american express / discover
  card5 STRING,
  card6 STRING                        // credit / debit
) WITH primary_id_as_attribute="true"

CREATE VERTEX Transaction (
  PRIMARY_ID transaction_id STRING,
  transaction_dt UINT,                // seconds from dataset start (disguised, but order-preserving at coarse scale)
  ts DATETIME,                        // real timestamp, July 2 - Dec 31 2016
  transaction_amt DOUBLE,
  product_cd STRING,                  // W (in-person, no device record), C, H, R, S
  channel STRING,                     // in_person | online
  addr1 DOUBLE,                       // billing region code
  addr2 DOUBLE,                       // billing country (87 = home country)
  dist1 DOUBLE, dist2 DOUBLE,
  p_emaildomain STRING,
  r_emaildomain STRING,
  risk_score DOUBLE                   // bank's detection model score -- an input, never a verdict
) WITH primary_id_as_attribute="true"

CREATE VERTEX DeviceProfile (
  PRIMARY_ID device_profile_id STRING,  // "DeviceInfo | OS | browser | screen", only for specific (non-generic) DeviceInfo values
  device_info STRING,
  os STRING,
  browser STRING,
  screen STRING
) WITH primary_id_as_attribute="true"

CREATE VERTEX EmailDomain (
  PRIMARY_ID domain STRING
) WITH primary_id_as_attribute="true"

CREATE VERTEX BillingRegion (
  PRIMARY_ID addr1 STRING
) WITH primary_id_as_attribute="true"

CREATE VERTEX ClosedCase (
  PRIMARY_ID case_id STRING,          // e.g. "CC-0001"
  customer_id STRING,
  card_id STRING,
  opened_at DATETIME,
  closed_at DATETIME,
  outcome STRING,                     // confirmed_fraud | cleared
  pattern STRING,                     // one of the 5 known patterns, "undocumented", or "none"
  first_fraud_txn_id STRING,
  n_txns UINT,
  exposure_usd DOUBLE,
  actions_taken STRING,
  report_filed BOOL,
  analyst_notes STRING
) WITH primary_id_as_attribute="true"

// ---------------------------------------------------------------------------
// Investigation / case-management vertices (not in the README's suggested
// schema, added so the agent's own investigations become graph-native case
// memory for future runs, per "write it into the graph too")
// ---------------------------------------------------------------------------

CREATE VERTEX Case (
  PRIMARY_ID case_id STRING,          // "CASE-HHG-001"
  source_case_id STRING,              // the case_pack.csv case_id, e.g. "HHG-001"
  status STRING,                      // open | closed_fraud | closed_legitimate | escalated
  verdict STRING,                     // fraud | legitimate | uncertain
  fraud_probability DOUBLE,
  pattern STRING,
  pattern_description STRING,
  exposure_usd DOUBLE,
  summary STRING,
  written_at DATETIME
) WITH primary_id_as_attribute="true"

CREATE VERTEX Evidence (
  PRIMARY_ID evidence_id STRING,
  case_id STRING,
  claim STRING,
  source STRING,                      // graph | document | customer | external
  ref STRING,
  collected_at DATETIME
) WITH primary_id_as_attribute="true"

CREATE VERTEX Decision (
  PRIMARY_ID decision_id STRING,
  case_id STRING,
  phase STRING,                       // initial | final
  action STRING,
  route STRING,                       // auto | L1 | L2
  reason STRING
) WITH primary_id_as_attribute="true"

// ---------------------------------------------------------------------------
// Edges (names mirror the dataset README's "Suggested graph schema")
// ---------------------------------------------------------------------------

CREATE DIRECTED EDGE OWNS (FROM Customer, TO Card) WITH REVERSE_EDGE="OWNED_BY"
CREATE DIRECTED EDGE MADE (FROM Card, TO Transaction) WITH REVERSE_EDGE="MADE_BY"
CREATE DIRECTED EDGE FROM_DEVICE (FROM Transaction, TO DeviceProfile) WITH REVERSE_EDGE="DEVICE_USED_IN"
CREATE DIRECTED EDGE PURCHASER_EMAIL (FROM Transaction, TO EmailDomain) WITH REVERSE_EDGE="EMAIL_USED_IN_PURCHASE"
CREATE DIRECTED EDGE BILLED_IN (FROM Transaction, TO BillingRegion) WITH REVERSE_EDGE="REGION_BILLED"
CREATE DIRECTED EDGE NEXT (FROM Transaction, TO Transaction)  // ordered by ts within a card

CREATE DIRECTED EDGE INVOLVES (FROM ClosedCase, TO Transaction) WITH REVERSE_EDGE="TRANSACTION_IN_CLOSED_CASE"
CREATE DIRECTED EDGE ON_CARD (FROM ClosedCase, TO Card) WITH REVERSE_EDGE="CARD_HAS_CLOSED_CASE"
CREATE DIRECTED EDGE CONNECTED_TO (FROM ClosedCase, TO Card) WITH REVERSE_EDGE="CARD_CONNECTED_TO_CASE"

CREATE DIRECTED EDGE CASE_ABOUT_CARD (FROM Case, TO Card) WITH REVERSE_EDGE="CARD_IN_CASE"
CREATE DIRECTED EDGE CASE_ABOUT_TRANSACTION (FROM Case, TO Transaction) WITH REVERSE_EDGE="TRANSACTION_IN_CASE"
CREATE DIRECTED EDGE CASE_CONNECTED_CARD (FROM Case, TO Card) WITH REVERSE_EDGE="CARD_CONNECTED_TO_CASE_MEMORY"
CREATE DIRECTED EDGE CASE_HAS_EVIDENCE (FROM Case, TO Evidence) WITH REVERSE_EDGE="EVIDENCE_OF_CASE"
CREATE DIRECTED EDGE CASE_HAS_DECISION (FROM Case, TO Decision) WITH REVERSE_EDGE="DECISION_OF_CASE"
CREATE UNDIRECTED EDGE CASE_SIMILAR_TO_CLOSED (FROM Case, TO ClosedCase)  // case-memory link, written after retrieval

ADD VERTEX Customer, Card, Transaction, DeviceProfile, EmailDomain, BillingRegion, ClosedCase,
           Case, Evidence, Decision
    TO GRAPH FraudInvestigation
ADD EDGE OWNS, MADE, FROM_DEVICE, PURCHASER_EMAIL, BILLED_IN, NEXT,
         INVOLVES, ON_CARD, CONNECTED_TO,
         CASE_ABOUT_CARD, CASE_ABOUT_TRANSACTION, CASE_CONNECTED_CARD,
         CASE_HAS_EVIDENCE, CASE_HAS_DECISION, CASE_SIMILAR_TO_CLOSED
    TO GRAPH FraudInvestigation
